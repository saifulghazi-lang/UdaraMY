{
  "rewrites": [
    {
      "source": "/api3/publicportalapims/apitablehourly",
      "destination": "https://eqms.doe.gov.my/api3/publicportalapims/apitablehourly"
    },
    {
      "source": "/asmc/files/msscommunity/hotspots/:file(DailyJP1NOAA20\\.(?:sumatra|kalimantan|p_malaysia)\\.txt)",
      "destination": "https://asmc.asean.org/files/msscommunity/hotspots/:file"
    },
    {
      "source": "/openaq/locations/:match*",
      "destination": "https://api.openaq.org/v3/locations/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' https://eqms.doe.gov.my https://asmc.asean.org https://api.openaq.org https://api.open-meteo.com https://air-quality-api.open-meteo.com; font-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
