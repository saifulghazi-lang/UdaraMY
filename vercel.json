{
  "rewrites": [
    {
      "source": "/api3/:match*",
      "destination": "https://eqms.doe.gov.my/api3/:match*"
    },
    {
      "source": "/asmc/:match*",
      "destination": "https://asmc.asean.org/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=()"
        }
      ]
    }
  ]
}
